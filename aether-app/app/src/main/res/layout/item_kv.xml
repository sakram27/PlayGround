<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="10dp">
    <TextView android:id="@+id/k" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/mut" android:textSize="13sp" />
    <TextView android:id="@+id/v" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="end" android:textColor="@color/txt"
        android:textSize="13sp" android:fontFamily="monospace" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
