<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="UNDUH BERTAHAP" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Endpoint publik gratis (tanpa kunci). Laju dibatasi; bisa dibatalkan. Berhenti bila aplikasi ditutup — bukan layanan 24 jam."
                    android:textColor="@color/dim" android:textSize="11sp"
                    android:layout_marginTop="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Field" android:hint="Pair">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/colPair" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnCol1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="1 bln" style="@style/BtnGhost"
                        android:minHeight="38dp" android:textSize="11sp" />
                    <Button android:id="@+id/btnCol3" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="3 bln" style="@style/BtnGhost"
                        android:minHeight="38dp" android:textSize="11sp" />
                    <Button android:id="@+id/btnCol6" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="6 bln" style="@style/BtnGhost"
                        android:minHeight="38dp" android:textSize="11sp" />
                    <Button android:id="@+id/btnCol12" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="12 bln" style="@style/BtnGhost"
                        android:minHeight="38dp" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnColTf" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="TF: 1h" style="@style/BtnGhost"
                        android:minHeight="44dp" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <Button android:id="@+id/btnColDl" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Unduh" style="@style/BtnPrimary"
                        android:minHeight="44dp" />
                </LinearLayout>
                <TextView android:id="@+id/colRange" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KATALOG ARSIP" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/colEmpty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="13sp" android:gravity="center" android:padding="16dp"
                    android:text="Belum ada arsip. Ketuk item untuk menghapusnya." />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/colList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
