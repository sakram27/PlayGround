<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2: band eksekusi + hasil datar. ID lama utuh. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WALK-FORWARD" style="@style/TxLabel" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Data dibagi berurutan; tiap lipatan diuji dengan parameter identik. Warmup hanya dari masa lalu lipatan itu."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/btnWf2" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="2" style="@style/BtnViolet" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnWf3" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="3" style="@style/BtnViolet" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnWf4" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="4" style="@style/BtnViolet" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <TextView android:id="@+id/wfFolds" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:textColor="@color/mut" android:textSize="12sp"
                    android:gravity="center_vertical|end" /></LinearLayout>
            <Button android:id="@+id/btnWfRun" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Jalankan"
                style="@style/BtnPrimary" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/wfStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/wfPooled" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/txt"
                android:textSize="14sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/wfList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
