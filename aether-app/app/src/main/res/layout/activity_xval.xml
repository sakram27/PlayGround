<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VALIDASI SILANG" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Binance vs Bybit, simbol &amp; kuotasi identik. Kecocokan bukan bukti benar."
                    android:textColor="@color/dim" android:textSize="11sp"
                    android:layout_marginTop="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Field" android:hint="Simbol">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/xvPair" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnXvTf" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="TF: 15m" style="@style/BtnGhost"
                        android:minHeight="44dp" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <Button android:id="@+id/btnXvRun" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Bandingkan" style="@style/BtnGhost"
                        android:minHeight="44dp" />
                </LinearLayout>
                <TextView android:id="@+id/xvStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" android:layout_marginTop="6dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/xvList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
