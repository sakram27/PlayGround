<?xml version="1.0" encoding="utf-8"?>
<!-- Markets: header → data & filter → status ringkas → kustom → watchlist → sinyal.
     Semua ID lama dipertahankan (wiring utuh). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- DATA & FILTER -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DATA PASAR" style="@style/TxLabel" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/segCat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/segCrypto" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Crypto" style="@style/BtnGhost" />
                <com.google.android.material.button.MaterialButton android:id="@+id/segForex" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Forex" style="@style/BtnGhost" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fldProv" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" style="@style/Field"
                android:hint="Provider" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spProv" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none"
                    android:focusable="true" android:clickable="true"
                    android:maxLines="1" android:ellipsize="end" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/provStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" android:text="—" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fldTf" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" style="@style/Field" android:hint="Timeframe"
                app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spTf" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none"
                    android:focusable="true" android:clickable="true"
                    android:maxLines="1" android:ellipsize="end" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" style="@style/Field" android:hint="Cari pair…">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- STATUS RINGKAS -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:text="Siap." />
            <TextView android:id="@+id/fallbackBanner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/amber"
                android:textSize="12sp" android:visibility="gone"
                android:background="@drawable/bg_pill" android:padding="10dp"
                android:layout_marginTop="8dp" />
            <Button android:id="@+id/btnRetry" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Coba lagi"
                style="@style/BtnCyan" android:layout_marginTop="8dp" android:visibility="gone" />
        </LinearLayout>

        <!-- WATCHLIST KUSTOM -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WATCHLIST KUSTOM" style="@style/TxLabel" />
            <TextView android:id="@+id/customCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Jumlah tampil" android:textColor="@color/mut"
                android:textSize="11sp" android:layout_marginTop="10dp" />
            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:scrollbars="none">
                <LinearLayout android:id="@+id/limitChips" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" style="@style/Field" android:hint="Kustom 1–200">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inWatchLimit" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnWatchLimit" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Terapkan"
                    style="@style/BtnViolet" />
            </LinearLayout>
            <TextView android:id="@+id/freshStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btnAddPair" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="＋ Tambah Pasangan" style="@style/BtnPrimary" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnResetWatch" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Reset" style="@style/BtnDanger" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Seret ⠿ untuk mengubah urutan. Urutan tersimpan otomatis. Maks 30 pair tampil (1 pair = 1 request + komputasi 200 candle)."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="6dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/customList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- WATCHLIST -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="12dp">
            <TextView android:id="@+id/watchHead" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WATCHLIST" style="@style/TxLabel"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:layout_margin="12dp" android:visibility="gone" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:gravity="center" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="4dp"
                android:background="@color/graphite_800" />
        </LinearLayout>

        <!-- SINYAL TERBARU -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Sinyal Terbaru"
                    android:textColor="@color/txt" android:textSize="15sp"
                    android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <Button android:id="@+id/btnAllSig" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Semua →"
                    style="@style/BtnInfo" />
            </LinearLayout>
            <TextView android:id="@+id/sigEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:visibility="gone" android:layout_marginTop="4dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/sigList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
