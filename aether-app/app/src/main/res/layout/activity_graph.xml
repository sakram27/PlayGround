<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2 grafik: hero band (pair raksasa + harga) → strip TF →
     chart full-bleed tinggi. ID lama dipertahankan. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/pairIcon" android:layout_width="34dp"
                    android:layout_height="34dp" android:layout_marginEnd="10dp" />
                <TextView android:id="@+id/sym" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="—" android:textColor="@color/txt" android:textSize="24sp"
                    android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/price" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="…" android:textColor="@color/txt"
                android:textSize="30sp" android:textStyle="bold" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/segTf" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="12dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/segTfM5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="M5" style="@style/BtnGhost" />
            <com.google.android.material.button.MaterialButton android:id="@+id/segTfM15" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="M15" style="@style/BtnGhost" />
            <com.google.android.material.button.MaterialButton android:id="@+id/segTfH1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="H1" style="@style/BtnGhost" />
            <com.google.android.material.button.MaterialButton android:id="@+id/segTfH4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="H4" style="@style/BtnGhost" />
            <com.google.android.material.button.MaterialButton android:id="@+id/segTfD1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="D1" style="@style/BtnGhost" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <FrameLayout android:layout_width="match_parent"
            android:layout_height="440dp" android:background="@color/graphite_800">
            <com.github.mikephil.charting.charts.CombinedChart
                android:id="@+id/chart" android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp" android:paddingEnd="4dp"
                android:paddingTop="8dp" android:paddingBottom="8dp" />
            <LinearLayout android:id="@+id/chartOverlay"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center"
                android:background="#A00B0E14" android:visibility="gone"
                android:padding="16dp">
                <ProgressBar android:id="@+id/chartLoading"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:visibility="gone" />
                <TextView android:id="@+id/chartMsg"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/mut" android:textSize="13sp"
                    android:gravity="center" android:visibility="gone" />
                <Button android:id="@+id/chartRetry"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Coba lagi" style="@style/BtnCyan"
                    android:layout_marginTop="8dp" android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sentuh = OHLC · Cubit = zoom · Geser = gulir"
            android:textColor="@color/dim" android:textSize="11sp" android:gravity="center"
            android:layout_marginTop="8dp" android:layout_marginBottom="12dp" />
    </LinearLayout>
</ScrollView>
