<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2 jurnal: band filter + daftar full-bleed. ID lama utuh. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CARI &amp; SARING" style="@style/TxLabel" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/Field" android:hint="Cari judul, isi, atau pair">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/jSearch" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/Field" android:hint="Pair" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/jPair" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/jPeriodGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/jPeriodAll"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Semua waktu" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/jPeriod7"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="7 hari" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/jPeriod30"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="30 hari" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <Button android:id="@+id/btnJAdd" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="＋ Catatan"
                style="@style/BtnPrimary" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/jCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="JURNAL" style="@style/TxLabel"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/jList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="6dp"
                android:background="@color/graphite_800" />
            <TextView android:id="@+id/jEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="13sp" android:gravity="center" android:padding="16dp"
                android:text="Belum ada catatan." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
