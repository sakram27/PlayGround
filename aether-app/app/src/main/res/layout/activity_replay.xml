<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2 replay: panggung strip dominan + transport → jurnal full-bleed.
     ID lama dipertahankan. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:id="@+id/rpTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="@color/dim" android:textSize="11sp"
                android:fontFamily="monospace" />
            <com.aether.signal.premium.ui.ReplayStripView
                android:id="@+id/rpStrip" android:layout_width="match_parent"
                android:layout_height="180dp" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/rpBar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—"
                android:textColor="@color/txt" android:textSize="20sp"
                android:textStyle="bold" android:fontFamily="monospace"
                android:layout_marginTop="10dp" />
            <TextView android:id="@+id/rpTime" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/rpOhlc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/txt"
                android:textSize="13sp" android:fontFamily="monospace"
                android:layout_marginTop="6dp" />
            <TextView android:id="@+id/rpInd" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
            <TextView android:id="@+id/rpDecision" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/amber"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginTop="8dp" />
            <TextView android:id="@+id/rpPosition" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/txt"
                android:textSize="12sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btnRpReset" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="⏮" style="@style/BtnGhost" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnRpBack" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="◀" style="@style/BtnGhost" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnRpPlay" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="▶ Putar" style="@style/BtnPrimary" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnRpStep" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="▶|" style="@style/BtnGhost" /></LinearLayout>
            <TextView android:id="@+id/rpStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="JURNAL PERISTIWA" style="@style/TxLabel"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rpLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="6dp"
                android:background="@color/graphite_800" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
