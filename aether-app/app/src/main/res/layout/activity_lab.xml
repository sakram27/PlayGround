<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RUANG KERJA" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnBacktest" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Backtest Console →" style="@style/BtnPrimary" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <Button android:id="@+id/btnAi" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="AI Analysis →" style="@style/BtnGhost" />
                </LinearLayout>
                <TextView android:id="@+id/lastBt" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/dim"
                    android:textSize="11sp" android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STRATEGI · 25 BAWAAN" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" style="@style/Field" android:hint="Cari strategi…">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/search" android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/stratList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HYPEROPT · 27 KOMBINASI" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Grid-search SL × TP × risiko. Terbaik ≠ aktif — terapkan manual."
                    android:textColor="@color/mut" android:textSize="12sp"
                    android:layout_marginTop="4dp" />
                <Button android:id="@+id/btnOpt" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Jalankan Optimasi"
                    style="@style/BtnPrimary" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/optStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" android:layout_marginTop="6dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/optList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
