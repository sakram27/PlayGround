<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2 notifikasi: band filter + daftar full-bleed. ID lama utuh. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FILTER NOTIFIKASI" style="@style/TxLabel" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/Field" android:hint="Cari simbol, mis. BTC">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/histSearch" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Jenis peristiwa" android:textColor="@color/mut"
                android:textSize="11sp" android:layout_marginTop="10dp" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/histKindGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/histKindAll"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Semua" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histKindEntry"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Entry" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histKindTp"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="TP" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histKindSl"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="SL" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histKindTrail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Trail" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Status" android:textColor="@color/mut"
                android:textSize="11sp" android:layout_marginTop="10dp" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/histStatusGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/histStatusAll"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Semua" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histStatusSent"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Dikirim" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histStatusHeld"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Ditahan" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/histStatusFailed"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Gagal" style="@style/BtnGhost"
                    android:minHeight="38dp" android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/btnHistClearFilter" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Hapus filter" style="@style/BtnSlate" android:textSize="12sp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnHistExport" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Ekspor CSV" style="@style/BtnCyan" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/histCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RIWAYAT NOTIFIKASI" style="@style/TxLabel"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Catatan nyata dari kejadian live mesin (entry/SL/TP). &quot;Dipublikasikan ke Android&quot; berarti perintah tampil diterima tanpa error — kemunculan akhirnya tetap bergantung pengaturan sistem Android Anda. Bukan dari ID deduplikasi."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <TextView android:id="@+id/histStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp"
                android:paddingStart="16dp" android:paddingEnd="16dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/histList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="6dp"
                android:background="@color/graphite_800" />
            <TextView android:id="@+id/histEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="13sp" android:gravity="center" android:padding="16dp"
                android:text="Belum ada notifikasi tercatat. Riwayat terisi saat mesin live mengirim sinyal entry/SL/TP." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <Button android:id="@+id/btnHistClear" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Hapus riwayat"
                    style="@style/BtnDanger" />
                <Button android:id="@+id/btnHistResetDedup" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset deduplikasi (pisah dari riwayat)"
                    style="@style/BtnGhost" android:layout_marginTop="6dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Menghapus riwayat TIDAK menghapus status deduplikasi, sehingga notifikasi lama tidak terkirim ulang secara tidak sengaja. Reset deduplikasi dilakukan terpisah."
                    android:textColor="@color/dim" android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
