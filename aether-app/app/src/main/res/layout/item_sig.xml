<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP: tiket sinyal trading — accent bar arah + baris berlapis.
     Data tetap SigItem(dir, main, sub, right, sym); hanya komposisi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:minHeight="68dp">
    <View android:id="@+id/accent" android:layout_width="4dp"
        android:layout_height="match_parent" android:background="@color/line"
        android:layout_marginEnd="10dp" />
    <ImageView android:id="@+id/icon" android:layout_width="28dp" android:layout_height="28dp"
        android:visibility="gone" android:layout_marginEnd="2dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/dir" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textStyle="bold" android:background="@drawable/bg_pill"
                android:padding="6dp" />
            <TextView android:id="@+id/main" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/txt" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                android:layout_marginStart="10dp" />
            <TextView android:id="@+id/right" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/txt"
                android:textSize="13sp" android:fontFamily="monospace" android:maxLines="1"
                android:layout_marginStart="8dp" android:gravity="end" />
        </LinearLayout>
        <TextView android:id="@+id/sub" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/dim"
            android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"
            android:ellipsize="end" android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
