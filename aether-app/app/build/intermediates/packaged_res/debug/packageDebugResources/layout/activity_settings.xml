<?xml version="1.0" encoding="utf-8"?>
<!-- Settings 5 bagian: ENGINE & MONITORING → NOTIFIKASI → DATA PROVIDER →
     BATERAI & PERFORMA → TENTANG & AI. Semua ID lama dipertahankan. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. ENGINE & MONITORING -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ENGINE &amp; MONITORING" style="@style/TxLabel" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Pantau pasar di latar belakang tiap 60 detik memakai provider aktif. Android dapat membatasi layanan saat hemat baterai."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAlways" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Selalu Siaga"
                android:textColor="@color/txt" android:layout_marginTop="6dp"
                android:minHeight="48dp" />
            <TextView android:id="@+id/alwaysStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:fontFamily="monospace"
                android:layout_marginTop="6dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSaver" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Mode hemat baterai"
                android:textColor="@color/txt" android:layout_marginTop="6dp"
                android:minHeight="48dp" />
            <TextView android:id="@+id/saverStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 2. NOTIFIKASI -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NOTIFIKASI" style="@style/TxLabel" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Hanya dari kejadian live mesin (entry/SL/TP)."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifEntry" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Sinyal entry"
                android:textColor="@color/txt" android:layout_marginTop="6dp"
                android:minHeight="48dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifSl" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Stop loss tercapai"
                android:textColor="@color/txt" android:minHeight="48dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifTp" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Take profit tercapai"
                android:textColor="@color/txt" android:minHeight="48dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifTrail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Trailing stop (aktif/bergerak/kena)"
                android:textColor="@color/txt" android:minHeight="48dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifSound" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Suara"
                android:textColor="@color/txt" android:minHeight="48dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNotifVibrate" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Getaran"
                android:textColor="@color/txt" android:minHeight="48dp" />
            <TextView android:id="@+id/notifStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
            <Button android:id="@+id/btnNotifPerm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Aktifkan izin notifikasi"
                style="@style/BtnInfo" android:layout_marginTop="6dp" />
            <Button android:id="@+id/btnNotifTest" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Kirim notifikasi uji"
                style="@style/BtnCyan" android:layout_marginTop="6dp" />
            <Button android:id="@+id/btnNotifHistory" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Riwayat notifikasi"
                style="@style/BtnInfo" android:layout_marginTop="6dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDigest" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Digest per jam (gabung entry)"
                android:textColor="@color/txt" android:layout_marginTop="6dp"
                android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Digest: sinyal entry digabung jadi satu ringkasan per jam (satu bunyi). SL/TP tetap langsung. Riwayat individual tetap tersimpan. Jam tenang tetap berlaku."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="2dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="JAM TENANG" style="@style/TxLabel"
                android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tahan notifikasi Aether pada jam &amp; hari tertentu. Sinyal tetap dihitung dan tetap tersimpan."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swQuiet" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Aktifkan jam tenang"
                android:textColor="@color/txt" android:layout_marginTop="6dp"
                android:minHeight="48dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/btnQuietStart" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Mulai 22:00" style="@style/BtnGhost" android:textSize="12sp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnQuietEnd" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Selesai 07:00" style="@style/BtnGhost" android:textSize="12sp" />
            </LinearLayout>
            <Button android:id="@+id/btnQuietDays" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Pilih hari"
                style="@style/BtnGhost" android:layout_marginTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnQuietPresetWork" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Malam Hari Kerja" style="@style/BtnViolet" android:textSize="12sp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnQuietPresetWeekend" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Akhir Pekan" style="@style/BtnViolet" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/quietPresetStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/quietStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 3. DATA PROVIDER -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DATA PROVIDER" style="@style/TxLabel" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/Field" android:hint="Provider default">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spProv" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btnSave" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Simpan" style="@style/BtnPrimary" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnExport" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Export JSON" style="@style/BtnCyan" />
            </LinearLayout>
            <Button android:id="@+id/btnImport" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Import JSON (pulihkan)"
                style="@style/BtnCyan" android:layout_marginTop="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Export mencakup sinyal, riwayat, dan konfigurasi. Import menimpa konfigurasi saat ini."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="6dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/line" android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="KONEKSI" android:textColor="@color/txt"
                android:textSize="17sp" android:textStyle="bold" />
            <Button android:id="@+id/btnTest" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Tes Koneksi"
                style="@style/BtnCyan" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/connList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="KESEHATAN PROVIDER" style="@style/TxLabel"
                android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Status dari pemeriksaan nyata, bukan tebakan. Kosong = belum pernah diuji."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="4dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/healthList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 4. BATERAI & PERFORMA -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BATERAI &amp; PERFORMA" style="@style/TxLabel" />
            <TextView android:id="@+id/battStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="6dp" />
            <Button android:id="@+id/btnBatt" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Minta pengecualian baterai"
                style="@style/BtnGhost" android:layout_marginTop="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PERANGKAT &amp; JARINGAN" style="@style/TxLabel"
                android:layout_marginTop="12dp" />
            <TextView android:id="@+id/oemGuide" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HP Xiaomi/Oppo/Vivo/dll dapat menghentikan aplikasi di latar. Bila pantauan sering mati: kunci Aether di Recent Apps, izinkan Autostart, dan matikan pembatasan latar belakang khusus merek HP Anda."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <TextView android:id="@+id/netStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
            <Button android:id="@+id/btnBattSys" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Buka pengaturan baterai"
                style="@style/BtnGhost" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 5. TENTANG & AI -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TENTANG &amp; AI" style="@style/TxLabel" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Interpreter lokal atas data engine (tanpa API key, tanpa endpoint eksternal)."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Aether Signal 7.13 (debug) · com.aether.signal.premium · Android Native Kotlin + Material · Sinyal edukasi, bukan nasihat keuangan."
                android:textColor="@color/mut" android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
