<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Pilih" android:textColor="@color/txt"
        android:textSize="18sp" android:textStyle="bold" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" style="@style/Field" android:hint="Cari…">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnAll" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Pilih Semua" style="@style/BtnGhost" android:minHeight="38dp" />
        <Button android:id="@+id/btnClear" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Hapus Semua" style="@style/BtnGhost" android:minHeight="38dp" />
        <Button android:id="@+id/btnExtra" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Extra" style="@style/BtnGhost" android:minHeight="38dp"
            android:visibility="gone" />
    </LinearLayout>
    <ListView android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="280dp" android:layout_marginTop="8dp"
        android:choiceMode="multipleChoice" android:fastScrollEnabled="true"
        android:divider="@color/line" android:dividerHeight="1dp" />
    <TextView android:id="@+id/count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/mut"
        android:textSize="12sp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnApply" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="APPLY"
        style="@style/BtnPrimary" android:layout_marginTop="8dp" />
</LinearLayout>
