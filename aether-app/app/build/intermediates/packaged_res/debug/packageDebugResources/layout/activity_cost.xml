<?xml version="1.0" encoding="utf-8"?>
<!-- FLAGSHIP v2: band biaya + band funding. ID lama utuh. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/graphite_900">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SENSITIVITAS BIAYA · 16 SKENARIO + KUSTOM" style="@style/TxLabel" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" style="@style/Field" android:hint="Fee % kustom">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inCostFee" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" style="@style/Field" android:hint="Slip % kustom">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inCostSlip" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <Button android:id="@+id/btnCostRun" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Jalankan"
                style="@style/BtnPrimary" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/costStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/costList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/graphite_800"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FUNDING RATE · LAPORAN SAJA" style="@style/TxLabel" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Endpoint publik gratis (tanpa kunci). Hanya derivatif Binance/Bybit; spot &amp; Yahoo tak punya funding. Backtest tersimpan tidak diubah."
                android:textColor="@color/dim" android:textSize="11sp"
                android:layout_marginTop="4dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDeriv" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Posisi derivatif (funding berlaku)"
                android:textColor="@color/txt" android:layout_marginTop="8dp"
                android:minHeight="44dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Mati = asumsi spot (funding tidak diterapkan)."
                android:textColor="@color/dim" android:textSize="11sp" />
            <Button android:id="@+id/btnFundFetch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Ambil funding aktual"
                style="@style/BtnCyan" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnFund001" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Est 0,01%" style="@style/BtnViolet" android:textSize="11sp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnFund005" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Est 0,05%" style="@style/BtnViolet" android:textSize="11sp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnFund01" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Est 0,1%" style="@style/BtnViolet" android:textSize="11sp" /></LinearLayout>
            <TextView android:id="@+id/fundStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mut"
                android:textSize="12sp" android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
