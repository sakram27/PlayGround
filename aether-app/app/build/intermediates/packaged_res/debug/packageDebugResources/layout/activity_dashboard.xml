<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NET PNL RIWAYAT" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/heroNet" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="@color/txt" android:textSize="26sp"
                    android:fontFamily="monospace" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SINYAL" android:textColor="@color/dim" android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/kSig" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/txt" android:textSize="14sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TRADES" android:textColor="@color/dim" android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/kTr" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/txt" android:textSize="14sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="WIN" android:textColor="@color/dim" android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/kWin" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/txt" android:textSize="14sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="POSISI" android:textColor="@color/dim" android:textSize="9sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/kPos" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/txt" android:textSize="14sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <Button android:id="@+id/btnEngine" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Start Engine" style="@style/BtnPrimary" />
                    <TextView android:id="@+id/engStatus" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Berhenti." android:textColor="@color/mut"
                        android:textSize="12sp" android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Sinyal terbaru" android:textColor="@color/txt"
                        android:textSize="17sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnAllSig" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Semua →"
                        style="@style/BtnGhost" android:minHeight="38dp" />
                </LinearLayout>
                <TextView android:id="@+id/sigEmpty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/sigList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KONDISI PASAR (INFORMATIF)" android:textColor="@color/dim"
                    android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Dari cache indikator engine (EMA200 + ADX). Bukan kepastian; tak mengubah strategi."
                    android:textColor="@color/dim" android:textSize="11sp"
                    android:layout_marginTop="2dp" />
                <TextView android:id="@+id/regimeList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Strategi aktif" android:textColor="@color/txt"
                    android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/cfgMain" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/cfgLast" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/dim"
                    android:textSize="11sp" android:layout_marginTop="4dp" />
                <Button android:id="@+id/btnLab" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Buka Lab →"
                    style="@style/BtnGhost" android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
