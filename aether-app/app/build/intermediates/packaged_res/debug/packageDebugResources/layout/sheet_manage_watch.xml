<?xml version="1.0" encoding="utf-8"?>
<!-- Kelola watchlist (bottom sheet): semua kontrol jumlah + kustom di sini,
     halaman Markets utama hanya menampilkan harga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="KELOLA WATCHLIST" style="@style/TxLabel" />
    <TextView android:id="@+id/customCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/mut"
        android:textSize="12sp" android:layout_marginTop="6dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Jumlah tampil" android:textColor="@color/mut"
        android:textSize="11sp" android:layout_marginTop="10dp" />
    <HorizontalScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/limitChips" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" style="@style/Field" android:hint="Kustom 1–200">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inWatchLimit" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button android:id="@+id/btnWatchLimit" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Terapkan"
            style="@style/BtnViolet" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnAddPair" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="＋ Tambah Pasangan" style="@style/BtnPrimary" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button android:id="@+id/btnResetWatch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Reset" style="@style/BtnDanger" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Seret ⠿ untuk mengubah urutan. Urutan tersimpan otomatis. Maks 30 pair tampil (1 pair = 1 request + komputasi 200 candle)."
        android:textColor="@color/dim" android:textSize="11sp"
        android:layout_marginTop="6dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/customList"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" android:layout_marginTop="8dp" />
</LinearLayout>
