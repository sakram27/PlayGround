                    android:layout_marginTop="6dp" />
                <TextView android:id="@+id/equityMsg" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/mut"
                    android:textSize="12sp" android:gravity="center" android:padding="12dp"
                    android:visibility="gone"
                    android:text="Jalankan backtest untuk melihat equity curve." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
